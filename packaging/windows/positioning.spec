# PyInstaller spec of the Windows desktop build (works on Linux too, for testing the bundle).
#
#   python packaging/weights.py build/desktop/weights
#   python -m PyInstaller packaging/windows/positioning.spec --distpath dist --workpath build/pyinstaller
#
# The result is a folder (dist/MammographyPositioning/) with MammographyPositioning.exe, Python, the libraries,
# the static client, configs/models.yaml and the weights. A folder starts faster than a one-file build, which
# would unpack about a gigabyte into %TEMP% on every start.
import sys
from pathlib import Path

from PyInstaller.utils.hooks import collect_data_files, collect_submodules, copy_metadata

ROOT = Path(SPECPATH).resolve().parents[1]
WEIGHTS = ROOT / "build" / "desktop" / "weights"
if not (WEIGHTS / "positioning").is_dir():
    sys.exit(f"no weights at {WEIGHTS}: run  python packaging/weights.py {WEIGHTS}")

APP_MODULES = ("breast_seg.apps", "breast_seg.inference", "breast_seg.imaging", "breast_seg.positioning")

# The bundled registry enables only the models whose weights are bundled (an optional model without weights
# would otherwise be reported as an error on every start).
import yaml  # noqa: E402

registry = yaml.safe_load((ROOT / "configs" / "models.yaml").read_text(encoding="utf-8"))
for model in registry["models"]:
    model["enabled"] = bool(model.get("enabled", True)) and (WEIGHTS / model["weights"]).is_file()
CONFIGS = ROOT / "build" / "desktop" / "configs"
CONFIGS.mkdir(parents=True, exist_ok=True)
(CONFIGS / "models.yaml").write_text("# generated by packaging/windows/positioning.spec\n"
                                     + yaml.safe_dump(registry, sort_keys=False), encoding="utf-8")

datas = [(str(CONFIGS / "models.yaml"), "configs"), (str(WEIGHTS), "weights")]
datas += collect_data_files("breast_seg")  # the static client
datas += collect_data_files("ultralytics")  # model and tracker YAMLs read at import time
# pydicom finds the pylibjpeg decoders through package entry points, which live in the distributions' metadata.
for dist in ("pydicom", "pylibjpeg", "pylibjpeg-libjpeg", "pylibjpeg-openjpeg"):
    datas += copy_metadata(dist)

hiddenimports = (
    collect_submodules("breast_seg", filter=lambda name: name.startswith(APP_MODULES) or name.count(".") == 1)
    + collect_submodules("uvicorn")
    + ["libjpeg", "openjpeg", "pydicom.pixel_data_handlers.pylibjpeg_handler", "webview"]
)
excludes = ["PyQt5", "PyQt6", "PySide2", "PySide6", "IPython", "jupyter", "notebook", "tensorboard",
            "breast_seg.training", "breast_seg.datasets", "breast_seg.compare", "pytest"]

a = Analysis([str(Path(SPECPATH) / "launch.py")], datas=datas, hiddenimports=hiddenimports, excludes=excludes,
             noarchive=False)


def runtime_only(entries):
    """Drop what only a C++ extension build needs: static / import libraries, headers, CMake files."""
    keep = []
    for entry in entries:
        dest = entry[0].replace("\\", "/").lower()
        if dest.endswith((".lib", ".a", ".h", ".hpp", ".cuh")) or "/include/" in dest or "/share/cmake/" in dest:
            continue
        keep.append(entry)
    return keep


a.binaries = runtime_only(a.binaries)
a.datas = runtime_only(a.datas)

pyz = PYZ(a.pure)
try:  # the splash screen needs Tcl/Tk in the build Python (always there on Windows)
    import _tkinter  # noqa: F401

    splash = [Splash(str(ROOT / "assets" / "splash.png"), binaries=a.binaries, datas=a.datas, text_pos=None,
                     always_on_top=False)]
except ImportError:
    splash = []
exe = EXE(pyz, a.scripts, *splash, [], exclude_binaries=True, name="MammographyPositioning",
          icon=str(ROOT / "assets" / "icon.ico"), console=False, disable_windowed_traceback=False,
          upx=False)
coll = COLLECT(exe, a.binaries, a.datas, *[s.binaries for s in splash], upx=False, name="MammographyPositioning")
