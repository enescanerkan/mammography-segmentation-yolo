# Karşılaştırma / inference çıktıları (compare_output, _v4, _v4fix, _wavelet ...)
compare_output*/
compare_viz_demo/
predictions/
analysis_output/

# Yerel yardımcı scriptler + ürettikleri PNG/rapor klasörleri (~315 MB).
# Bunlar deneysel, tek seferlik iş akışları; repoya girmez.
tools/

# Sunum / rapor dosyaları (büyük ikili)
*.pptx

# Eğitim koşuları (runs/weights, cache, grafikler)
runs/

# Poz ağırlıkları (*.pt paylaşılmaz; README dokümantasyon olarak commit edilebilir)
pose_weights/*.pt
pose_weights/*.onnx
pose_weights/**/*.pt

# Kök dizine indirilen Ultralytics hub checkpoint’leri (ör. yolo26l-pose.pt)
/*.pt

# Legacy staging directory (positioning app ported into qt_app/positioning)
eklenecek/

# Runtime logs (rolling files written by qt_app.logging_setup)
medsam2_experiments/logs/
medsam2_experiments/*_train_*.log

# MedSAM2 fine-tune çıktıları: her koşu ~800 MB checkpoint
medsam2_experiments/work_dir*/
medsam2_experiments/checkpoints/

# Annotation tool YOLO checkpoints (downloaded separately, see docs/)
medsam2_experiments/qt_app/weights/
medsam2_experiments/qt_app/positioning/weights/

# Generated label / result artifacts from the GUIs
medsam2_experiments/qt_app/positioning/results/
**/labels/*.txt

